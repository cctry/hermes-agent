# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore
.gitmodules
.gitattributes

# ── Node / npm (not used in the slim image) ───────────────────────────────────
node_modules
package-lock.json
npm-debug.log*

# ── CI/CD ─────────────────────────────────────────────────────────────────────
.github
.envrc

# ── Python build artefacts ────────────────────────────────────────────────────
__pycache__
*.py[cod]
*.pyo
*.pyd
*.egg-info
dist/
build/
.eggs/
*.whl

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── Environment secrets ───────────────────────────────────────────────────────
.env

# ── Tests (not needed at runtime) ────────────────────────────────────────────
tests/
conftest.py

# ── Documentation & web assets (large, not needed in image) ──────────────────
docs/
landingpage/
website/
assets/
*.md

# ── Dev / editor files ────────────────────────────────────────────────────────
.plans/
plans/
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# ── Nix ───────────────────────────────────────────────────────────────────────
flake.nix
flake.lock
nix/

# ── RL / training environments (not needed in the slim image) ────────────────
tinker-atropos/
environments/

# ── Misc large artefacts ──────────────────────────────────────────────────────
*.tar.gz
*.zip
