# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore
.gitmodules
.gitattributes

# ── Node / npm (not used in the slim image) ───────────────────────────────────
node_modules
**/node_modules
.venv
**/.venv
.notebooklm-cli-venv/
.notebooklm-playwright/
.pip-cache/
.uv-cache/

# Built artifacts that are regenerated inside the image.  Excluded so local
# rebuilds on the developer's machine don't invalidate the npm-install layer
# that now depends on the full ui-tui/packages/hermes-ink/ tree being present.
ui-tui/dist/
ui-tui/packages/hermes-ink/dist/

# ── CI/CD ─────────────────────────────────────────────────────────────────────
.github
.envrc

# ── Python build artefacts ────────────────────────────────────────────────────
__pycache__
*.py[cod]
*.pyo
*.pyd
*.egg-info
dist/
build/
.eggs/
*.whl

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── Environment secrets ───────────────────────────────────────────────────────
.env

# ── Tests (not needed at runtime) ────────────────────────────────────────────
tests/
conftest.py

# ── Documentation & web assets (large, not needed in image) ──────────────────
docs/
landingpage/
website/
assets/
*.md

# Runtime data (bind-mounted at /opt/data; must not leak into build context)
data/
.hermes-docker/
.notebooklm-home/

# Compose/profile runtime state (bind-mounted; avoid ownership/secret issues)
hermes-config/
runtime/

# ── Dev / editor files ────────────────────────────────────────────────────────
.plans/
plans/
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# ── Nix ───────────────────────────────────────────────────────────────────────
flake.nix
flake.lock
nix/

# ── RL / training environments (not needed in the slim image) ────────────────
tinker-atropos/
environments/

# ── Misc large artefacts ──────────────────────────────────────────────────────
*.tar.gz
*.zip
