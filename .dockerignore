*.py[cod]
*$py.class
*.so
.Python
*.pyo
*.pyd
*.egg-info
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments and dependency caches
.venv
.venv/
**/.venv
venv/
env/
ENV/
.env/
node_modules
**/node_modules
.notebooklm-cli-venv/
.notebooklm-playwright/
.pip-cache/
.uv-cache/

# Built artifacts regenerated inside the image
ui-tui/dist/
ui-tui/packages/hermes-ink/dist/

# CI/CD and environment files
.github
.env
.env.*

# IDE and developer files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Tests and coverage
tests/
conftest.py
.pytest_cache/
.coverage
htmlcov/

# Documentation and web assets not needed at runtime
*.md
website/
docs/
landingpage/
assets/
infographic/
plugins/hermes-achievements/docs/

# Runtime data (bind-mounted at /opt/data; must not leak into build context)
data/
.hermes-docker/
.notebooklm-home/
hermes-config/
runtime/

# Desktop app source is not installed in the container
apps/

# Packaging and repository metadata not needed in the image
nix/
flake.nix
flake.lock
packaging/
plans/
.plans/
acp_registry/
.env.example
.envrc
.hadolint.yaml
.mailmap
LICENSE

# RL and training environments not needed in the slim image
tinker-atropos/
environments/

# Miscellaneous large artifacts
*.tar.gz
*.zip
